{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Campanhas — da lista escolhida até a resposta que volta",
    "subtitle": "Modo WAHA: o ritmo é do número (channel_knobs + pacing_ledger). Modo oficial: modelo aprovado em lotes, sem anti-ban (issue #8). Proteções (issue #9): limite do portfólio, pausa automática com motivo, aceite do risco no QR code e o modo dois números. A resposta cai no funil e no agente da campanha (issue #11)",
    "output": "campanhas.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "tela", "label": "Tela" },
    { "id": "api", "label": "Borda HTTP (manager+)" },
    { "id": "motor", "label": "Rodadas (cron e worker)" },
    { "id": "envio", "label": "Cadeia de envio que já existia" },
    { "id": "dados", "label": "Dados" },
    { "id": "retorno", "label": "Laço de retorno" }
  ],
  "mainPath": [
    "nova",
    "rota-criar",
    "rota-acao",
    "preparacao",
    "campaign-recipients",
    "rodada",
    "send-handler",
    "messages",
    "detalhe"
  ],
  "nodes": [
    {
      "id": "lista",
      "lane": "tela",
      "col": 0,
      "type": "ui",
      "label": "Lista de campanhas (/app/campaigns)"
    },
    {
      "id": "nova",
      "lane": "tela",
      "col": 1,
      "type": "ui",
      "label": "Nova campanha (/app/campaigns/new) — público, texto, ritmo"
    },
    {
      "id": "detalhe",
      "lane": "tela",
      "col": 2,
      "type": "ui",
      "label": "Detalhe (/app/campaigns/[id]) — funil, destinatários e ações do estado"
    },
    {
      "id": "antiban",
      "lane": "tela",
      "col": 3,
      "type": "ui",
      "label": "Conexões › Proteção de envio (AntiBanSheet) — o ritmo do número"
    },
    {
      "id": "rota-criar",
      "lane": "api",
      "col": 0,
      "type": "service",
      "label": "GET/POST /api/v1/campaigns + PATCH /[id] (só rascunho edita)"
    },
    {
      "id": "rota-previa",
      "lane": "api",
      "col": 1,
      "type": "service",
      "label": "POST /api/v1/campaigns/preview — conta sem gravar"
    },
    {
      "id": "rota-acao",
      "lane": "api",
      "col": 2,
      "type": "service",
      "label": "POST /api/v1/campaigns/[id]/[acao] — preparar, iniciar, pausar, cancelar, testar"
    },
    {
      "id": "rota-metricas",
      "lane": "api",
      "col": 3,
      "type": "service",
      "label": "GET /[id]/metrics e /[id]/recipients — funil por carimbo, paginado"
    },
    {
      "id": "maquina",
      "lane": "api",
      "col": 4,
      "type": "logic",
      "label": "maquina-de-estados.ts — única autoridade sobre a transição"
    },
    {
      "id": "preparacao",
      "lane": "motor",
      "col": 0,
      "type": "logic",
      "label": "preparacao.ts — recorte vira lista congelada, com os excluídos e o motivo"
    },
    {
      "id": "rodada",
      "lane": "motor",
      "col": 1,
      "type": "worker",
      "label": "cron campaign-worker → rodada.ts: 1 mensagem por número por tique"
    },
    {
      "id": "ritmo",
      "lane": "motor",
      "col": 2,
      "type": "logic",
      "label": "ritmo.ts — intervalo, janela e tetos DA CAMPANHA (o mais restritivo vence)"
    },
    {
      "id": "elegibilidade",
      "lane": "motor",
      "col": 3,
      "type": "logic",
      "label": "elegibilidade.ts — bloqueado, anonimizado, recusou marketing, sem telefone, duplicado"
    },
    {
      "id": "pacing",
      "lane": "envio",
      "col": 0,
      "type": "logic",
      "label": "decidePacing + pacing_ledger — o ritmo do NÚMERO, compartilhado com o agente"
    },
    {
      "id": "send-handler",
      "lane": "envio",
      "col": 1,
      "type": "service",
      "label": "sendMessageHandler (a mesma porta do inbox e do follow-up)"
    },
    {
      "id": "adapter",
      "lane": "envio",
      "col": 2,
      "type": "external",
      "label": "ChannelAdapter — a campanha nunca fala com o provedor"
    },
    {
      "id": "campaigns",
      "lane": "dados",
      "col": 0,
      "type": "database",
      "label": "campaigns — estado, conteúdo, base legal + LIA, ritmo próprio, contadores do snapshot"
    },
    {
      "id": "campaign-recipients",
      "lane": "dados",
      "col": 1,
      "type": "database",
      "label": "campaign_recipients — quem recebe, com o texto congelado e os carimbos"
    },
    {
      "id": "messages",
      "lane": "dados",
      "col": 2,
      "type": "database",
      "label": "messages — a mensagem da campanha é outbound normal, na conversa do contato"
    },
    {
      "id": "channel-knobs",
      "lane": "dados",
      "col": 3,
      "type": "database",
      "label": "channel_knobs + channel_sessions.daily_message_limit — fonte única do ritmo do número"
    },
    {
      "id": "trigger-ack",
      "lane": "retorno",
      "col": 0,
      "type": "logic",
      "label": "trg_messages_sincroniza_campanha — ack vira entregue/lido; status nunca retrocede"
    },
    {
      "id": "resposta",
      "lane": "retorno",
      "col": 1,
      "type": "worker",
      "label": "resposta.handler.ts em message.received — fecha o envio em até 72h"
    },
    {
      "id": "opt-out",
      "lane": "retorno",
      "col": 2,
      "type": "logic",
      "label": "contacts.is_blocked (escrito por lib/opt-out) — fecha o que ainda iria sair"
    },
    {
      "id": "lgpd",
      "lane": "retorno",
      "col": 3,
      "type": "logic",
      "label": "trg_redigir_campanhas_anonimizado + export-collector — apaga e entrega"
    },
    {
      "id": "rota-modelos",
      "lane": "api",
      "col": 5,
      "type": "service",
      "label": "GET /api/v1/campaigns/modelos — aprovados da conta do número oficial, com as variáveis"
    },
    {
      "id": "rodada-oficial",
      "lane": "motor",
      "col": 4,
      "type": "worker",
      "label": "laço do worker + cron → rodada-oficial.ts: lotes paralelos, reserva SKIP LOCKED, sem anti-ban"
    },
    {
      "id": "meta-templates",
      "lane": "dados",
      "col": 4,
      "type": "database",
      "label": "meta_templates — o modelo aprovado que campaigns.meta_template_id referencia"
    },
    {
      "id": "falha-oficial",
      "lane": "retorno",
      "col": 4,
      "type": "logic",
      "label": "falha-oficial.ts + desfecho-oficial.ts — temporário volta, 131049 espera 24 h, 131050 grava a recusa"
    },
    {
      "id": "webhook-meta",
      "lane": "retorno",
      "col": 5,
      "type": "external",
      "label": "webhook da Meta (status assinado) — entregue, lido e a falha que chega depois"
    },
    {
      "id": "resposta-no-funil",
      "lane": "retorno",
      "col": 6,
      "type": "logic",
      "label": "resposta-no-funil.ts — a resposta cria ou move o card, aplica quem assume e o botão tocado (issue #11)"
    },
    {
      "id": "crm-leads",
      "lane": "dados",
      "col": 5,
      "type": "database",
      "label": "crm_leads + crm_lead_activities (campaign_replied)"
    },
    {
      "id": "contexto-agente",
      "lane": "motor",
      "col": 5,
      "type": "logic",
      "label": "contexto-do-agente.ts — nome, modelo, texto recebido, variáveis e oferta no turno do agente"
    },
    {
      "id": "fila-da-passagem",
      "lane": "retorno",
      "col": 7,
      "type": "logic",
      "label": "fila-da-passagem.ts — 'IA e depois humano': a passagem pede o rodízio de atendentes"
    }
,
    {
      "id": "aviso-risco",
      "lane": "tela",
      "col": 4,
      "type": "ui",
      "label": "aviso de risco de banimento (QR code) antes de iniciar/agendar; cartão 'Pausada automaticamente' e o limite do portfólio na página"
    },
    {
      "id": "portfolio",
      "lane": "motor",
      "col": 5,
      "type": "logic",
      "label": "portfolio.ts + fn_campanha_reservar_lote_no_portfolio — contatos únicos em 24 h no portfólio inteiro, reserva sob trava única"
    },
    {
      "id": "dois-numeros",
      "lane": "api",
      "col": 6,
      "type": "logic",
      "label": "dois-numeros.ts — botão wa.me do modelo abre o número de QR code; a variável do botão sai desse número"
    },
    {
      "id": "pausa-automatica",
      "lane": "retorno",
      "col": 6,
      "type": "logic",
      "label": "pausa-automatica.ts — qualidade vermelha e modelo rejeitado/pausado/desativado/recategorizado pausam com pausa_motivo + pausa_detalhe; audita campaign.auto_paused"
    },
    {
      "id": "channel-sessions",
      "lane": "dados",
      "col": 5,
      "type": "database",
      "label": "channel_sessions — meta_portfolio_id (da WABA, na conexão), meta_qualidade, meta_limite_de_mensagens"
    }
  ],
  "edges": [
    { "id": "lista-abre-nova", "from": "lista", "to": "nova", "label": "Nova campanha" },
    { "id": "nova-cria", "from": "nova", "to": "rota-criar", "label": "POST cria o rascunho" },
    { "id": "nova-preve", "from": "nova", "to": "rota-previa", "label": "quantas pessoas isto pega" },
    { "id": "previa-le-lista", "from": "rota-previa", "to": "preparacao", "label": "mesma consulta e mesma classificação" },
    { "id": "detalhe-aciona", "from": "detalhe", "to": "rota-acao", "label": "preparar, testar, iniciar, pausar, cancelar" },
    { "id": "acao-consulta-maquina", "from": "rota-acao", "to": "maquina", "label": "a transição cabe neste estado?" },
    { "id": "acao-prepara", "from": "rota-acao", "to": "preparacao", "label": "materializa o snapshot" },
    { "id": "preparacao-grava", "from": "preparacao", "to": "campaign-recipients", "label": "INSERT com texto congelado e motivo da exclusão" },
    { "id": "preparacao-classifica", "from": "preparacao", "to": "elegibilidade", "label": "quem pode receber" },
    { "id": "rota-criar-grava", "from": "rota-criar", "to": "campaigns", "label": "INSERT/UPDATE (só rascunho)" },
    { "id": "rodada-le-campanha", "from": "rodada", "to": "campaigns", "label": "running, org não suspensa; promove agendada" },
    { "id": "rodada-le-fila", "from": "rodada", "to": "campaign-recipients", "label": "próximo pendente, claim em compare-and-set" },
    { "id": "rodada-pergunta-ritmo", "from": "rodada", "to": "ritmo", "label": "pode mandar agora?" },
    { "id": "rodada-revalida", "from": "rodada", "to": "elegibilidade", "label": "revalida o veto por pessoa antes de enviar" },
    { "id": "ritmo-herda", "from": "ritmo", "to": "channel-knobs", "label": "null = herda o número" },
    { "id": "rodada-pergunta-canal", "from": "rodada", "to": "pacing", "label": "e o número, aguenta?" },
    { "id": "pacing-le-knobs", "from": "pacing", "to": "channel-knobs", "label": "janela, throttle, warm-up, teto" },
    { "id": "rodada-envia", "from": "rodada", "to": "send-handler", "label": "id da mensagem nasce antes (idempotência)" },
    { "id": "send-grava", "from": "send-handler", "to": "messages", "label": "outbound com metadata da campanha" },
    { "id": "send-chama-adapter", "from": "send-handler", "to": "adapter", "label": "entrega ao canal" },
    { "id": "messages-dispara-trigger", "from": "messages", "to": "trigger-ack", "label": "AFTER UPDATE OF status, delivered_at, read_at — compara o status efetivo" },
    { "id": "trigger-carimba", "from": "trigger-ack", "to": "campaign-recipients", "label": "sent → delivered → read" },
    { "id": "messages-emite-inbound", "from": "messages", "to": "resposta", "label": "message.received (trigger AFTER INSERT)" },
    { "id": "resposta-carimba", "from": "resposta", "to": "campaign-recipients", "label": "replied_at, dentro da janela de 72h" },
    { "id": "resposta-le-bloqueio", "from": "resposta", "to": "opt-out", "label": "o contato pediu para parar?" },
    { "id": "opt-out-fecha", "from": "opt-out", "to": "campaign-recipients", "label": "pendentes viram opted_out" },
    { "id": "lgpd-apaga", "from": "lgpd", "to": "campaign-recipients", "label": "anonimizar apaga telefone e texto; o export entrega" },
    { "id": "detalhe-le-metricas", "from": "detalhe", "to": "rota-metricas", "label": "funil, progresso e quem ficou de fora" },
    { "id": "metricas-le-destinatarios", "from": "rota-metricas", "to": "campaign-recipients", "label": "contagem por carimbo, não por status" },
    { "id": "antiban-edita-knobs", "from": "antiban", "to": "channel-knobs", "label": "o operador ajusta o ritmo do número aqui" },
    { "id": "nova-lista-modelos", "from": "nova", "to": "rota-modelos", "label": "número oficial: modelo e mapa de variáveis" },
    { "id": "modelos-le-espelho", "from": "rota-modelos", "to": "meta-templates", "label": "só APPROVED, da WABA do número" },
    { "id": "campanha-referencia-modelo", "from": "campaigns", "to": "meta-templates", "label": "meta_template_id (FK composta com a organização)" },
    { "id": "oficial-le-campanha", "from": "rodada-oficial", "to": "campaigns", "label": "running com modelo; promove agendada" },
    { "id": "oficial-reserva", "from": "rodada-oficial", "to": "campaign-recipients", "label": "fn_campanha_reservar_lote (SKIP LOCKED)" },
    { "id": "oficial-revalida", "from": "rodada-oficial", "to": "elegibilidade", "label": "revalida o veto por pessoa antes de enviar" },
    { "id": "oficial-janela", "from": "rodada-oficial", "to": "ritmo", "label": "janela e tetos da campanha (sem intervalo)" },
    { "id": "oficial-envia", "from": "rodada-oficial", "to": "send-handler", "label": "type: template, valores congelados no snapshot" },
    { "id": "oficial-decide-falha", "from": "rodada-oficial", "to": "falha-oficial", "label": "a Graph recusou na hora do envio" },
    { "id": "webhook-carimba", "from": "webhook-meta", "to": "messages", "label": "statuses: delivered_at / read_at / failed" },
    { "id": "webhook-falha-tardia", "from": "webhook-meta", "to": "falha-oficial", "label": "failed de mensagem de campanha" },
    { "id": "falha-recoloca", "from": "falha-oficial", "to": "campaign-recipients", "label": "volta à fila, opted_out ou failed com o motivo" },
    { "id": "falha-recusa-marketing", "from": "falha-oficial", "to": "elegibilidade", "label": "131050: consent.marketing.declined_at tira o contato das próximas" },
    { "id": "webhook-resposta-no-funil", "from": "webhook-meta", "to": "resposta-no-funil", "label": "resposta assinada: texto ou toque no botão, com context.id" },
    { "id": "resposta-le-campanha", "from": "resposta-no-funil", "to": "campaigns", "label": "lê funil, etapa, quem assume e o mapa dos botões" },
    { "id": "resposta-move-card", "from": "resposta-no-funil", "to": "crm-leads", "label": "cria na etapa da campanha ou move o que já existe, sem duplicar" },
    { "id": "resposta-botao-opt-out", "from": "resposta-no-funil", "to": "opt-out", "label": "botão de parar grava is_blocked (quick_reply_opt_out)" },
    { "id": "contexto-le-destinatario", "from": "contexto-agente", "to": "campaign-recipients", "label": "texto renderizado e variáveis de quem respondeu" },
    { "id": "contexto-le-campanha", "from": "contexto-agente", "to": "campaigns", "label": "nome, modelo e oferta" },
    { "id": "fila-le-campanha", "from": "fila-da-passagem", "to": "campaigns", "label": "quem_assume = ia_e_humano" },
    { "id": "rodada-pede-portfolio", "from": "rodada-oficial", "to": "portfolio", "label": "quanto cabe no limite do portfólio agora" },
    { "id": "portfolio-le-numeros", "from": "portfolio", "to": "channel-sessions", "label": "números do mesmo portfólio (inclusive de outra organização) e a menor faixa" },
    { "id": "portfolio-conta", "from": "portfolio", "to": "messages", "label": "modelos que saíram nas últimas 24 h" },
    { "id": "portfolio-reserva", "from": "portfolio", "to": "campaign-recipients", "label": "reserva só o que cabe (SKIP LOCKED, sob trava)" },
    { "id": "webhook-pausa", "from": "webhook-meta", "to": "pausa-automatica", "label": "qualidade vermelha / modelo rejeitado, pausado, desativado, recategorizado" },
    { "id": "rodada-pausa", "from": "rodada-oficial", "to": "pausa-automatica", "label": "rede de segurança: status do modelo e qualidade lidos sem webhook" },
    { "id": "pausa-grava", "from": "pausa-automatica", "to": "campaigns", "label": "paused + pausa_motivo + pausa_detalhe" },
    { "id": "detalhe-mostra-pausa", "from": "campaigns", "to": "aviso-risco", "label": "o motivo da pausa e o uso do limite na página" },
    { "id": "aviso-aceita", "from": "aviso-risco", "to": "rota-acao", "label": "aceitar-risco → risco_de_banimento_aceito_em/_por + campaign.ban_risk_accepted" },
    { "id": "criar-confere-dois-numeros", "from": "rota-criar", "to": "dois-numeros", "label": "numero_de_atendimento_id confere o botão wa.me" },
    { "id": "dois-numeros-preenche", "from": "dois-numeros", "to": "preparacao", "label": "variável do botão = telefone do número de QR code" },
    { "id": "resposta-pelo-contato", "from": "dois-numeros", "to": "resposta", "label": "quem responde no QR code cai no mesmo contato; a resposta conta pela ficha" }
  ]
}
