{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Modelos da API Oficial",
    "subtitle": "Sincronizar, criar no editor com preview (mídia, carrossel, oferta e flow), e o webhook de status, qualidade e categoria (issues #6 e #7)",
    "output": "modelos-da-api-oficial.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "operador",
      "label": "Operação"
    },
    {
      "id": "servidor",
      "label": "Servidor"
    },
    {
      "id": "banco",
      "label": "Persistência"
    },
    {
      "id": "externo",
      "label": "Meta"
    }
  ],
  "mainPath": ["editor", "regra", "submit", "graph", "espelho", "webhook", "eventos", "central"],
  "nodes": [
    {
      "id": "lista",
      "lane": "operador",
      "col": 1,
      "type": "frontend",
      "label": "Conexões › Templates da Meta (TemplatesClient) — status, categoria, qualidade, motivo, arquivo guardado"
    },
    {
      "id": "editor",
      "lane": "operador",
      "col": 1,
      "type": "frontend",
      "label": "EditorDeModelo — padrão, carrossel e oferta; mídia, corpo, exemplos, rodapé, botões (flow) e preview"
    },
    {
      "id": "regra",
      "lane": "servidor",
      "col": 2,
      "type": "lib",
      "label": "novo-modelo.ts — novoModeloSchema, problemasDoModelo, montarPedidoDeModelo, midiasDoModelo, previewDoModelo"
    },
    {
      "id": "submit",
      "lane": "servidor",
      "col": 3,
      "type": "route",
      "label": "POST /api/v1/channels/templates/submit → submeterModelo"
    },
    {
      "id": "sync",
      "lane": "servidor",
      "col": 3,
      "type": "route",
      "label": "POST /api/v1/channels/templates → syncTemplates (todas as páginas)"
    },
    {
      "id": "graph",
      "lane": "externo",
      "col": 4,
      "type": "external",
      "label": "Graph API — GET|POST /{waba}/message_templates"
    },
    {
      "id": "espelho",
      "lane": "banco",
      "col": 4,
      "type": "database",
      "label": "meta_templates (chave org+waba+nome+idioma, RLS; header_media = cópia por slot, migration 0537)"
    },
    {
      "id": "webhook",
      "lane": "servidor",
      "col": 5,
      "type": "route",
      "label": "POST /api/v1/webhooks/meta/[token] (status, qualidade, categoria)"
    },
    {
      "id": "eventos",
      "lane": "servidor",
      "col": 6,
      "type": "lib",
      "label": "eventos-de-modelo.ts — aplica com trava no valor lido; aviso uma vez por mudança"
    },
    {
      "id": "central",
      "lane": "banco",
      "col": 6,
      "type": "database",
      "label": "agent_inbox_items kind channel_template_review"
    },
    {
      "id": "centralTela",
      "lane": "operador",
      "col": 6,
      "type": "frontend",
      "label": "Central de avisos → link para a lista de modelos"
    },
    {
      "id": "envio",
      "lane": "servidor",
      "col": 5,
      "type": "lib",
      "label": "sendTemplateForSession — contrato com parameter_format do espelho"
    },
    {
      "id": "audit",
      "lane": "banco",
      "col": 3,
      "type": "database",
      "label": "api_audit_log meta_template.submitted | synced | media_uploaded"
    },
    {
      "id": "midia",
      "lane": "servidor",
      "col": 2,
      "type": "route",
      "label": "POST /api/v1/channels/templates/media → farejarArquivo, enviarMidiaParaMeta (midia-de-modelo.ts)"
    },
    {
      "id": "upload",
      "lane": "externo",
      "col": 3,
      "type": "external",
      "label": "Graph API — upload retomável: POST /{app}/uploads → POST /upload:… (handle)"
    },
    {
      "id": "bucket",
      "lane": "banco",
      "col": 2,
      "type": "database",
      "label": "Storage whatsapp-media <org>/templates/<uuid>.<ext> (a retenção só poda o que nenhum modelo cita, com mais de 7 dias)"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "editor",
      "to": "regra",
      "label": "mesmo schema e preview que o servidor"
    },
    { "id": "e2", "from": "editor", "to": "submit", "label": "Enviar para aprovação" },
    { "id": "e3", "from": "submit", "to": "regra", "label": "valida e monta o pedido" },
    { "id": "e4", "from": "submit", "to": "graph", "label": "POST com exemplos das variáveis" },
    {
      "id": "e5",
      "from": "submit",
      "to": "espelho",
      "label": "status e categoria QUE A META devolveu"
    },
    { "id": "e6", "from": "submit", "to": "audit", "label": "quem criou" },
    { "id": "e7", "from": "lista", "to": "sync", "label": "Sincronizar com a Meta" },
    { "id": "e8", "from": "sync", "to": "graph", "label": "GET paginado (cursor)" },
    { "id": "e9", "from": "sync", "to": "espelho", "label": "upsert; sumido vira DISABLED" },
    { "id": "e10", "from": "sync", "to": "audit", "label": "contagem do efeito" },
    { "id": "e11", "from": "graph", "to": "webhook", "label": "assinado com o App Secret" },
    {
      "id": "e12",
      "from": "webhook",
      "to": "eventos",
      "label": "org do token do path, nunca do corpo"
    },
    {
      "id": "e13",
      "from": "eventos",
      "to": "espelho",
      "label": "status / quality_score / category"
    },
    {
      "id": "e14",
      "from": "eventos",
      "to": "central",
      "label": "recusado, pausado, desativado, vermelho, recategorizado"
    },
    { "id": "e15", "from": "central", "to": "centralTela", "label": "aviso nomeia o modelo" },
    {
      "id": "e16",
      "from": "centralTela",
      "to": "lista",
      "label": "laço de retorno: o operador corrige ou cria outro"
    },
    { "id": "e17", "from": "espelho", "to": "lista", "label": "GET /api/v1/channels/templates" },
    {
      "id": "e18",
      "from": "espelho",
      "to": "envio",
      "label": "só APPROVED sai; NAMED leva parameter_name"
    },
    { "id": "e19", "from": "editor", "to": "midia", "label": "escolher o arquivo já envia" },
    {
      "id": "e20",
      "from": "midia",
      "to": "upload",
      "label": "app do token, file_length/type, file_offset 0, OAuth"
    },
    { "id": "e21", "from": "midia", "to": "bucket", "label": "cópia DEPOIS do aceite da Meta" },
    { "id": "e22", "from": "midia", "to": "audit", "label": "quem subiu (id = nome do arquivo)" },
    {
      "id": "e23",
      "from": "submit",
      "to": "espelho",
      "label": "header_media: caminho conferido contra a org da sessão"
    },
    {
      "id": "e24",
      "from": "bucket",
      "to": "lista",
      "label": "link assinado de 1 h do arquivo guardado"
    }
  ]
}
